// DB構造はMigrationのSQLを正典とし、このSchemaはPrisma用のマッピングを表す。
generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  reserved
  cancelled

  @@map("reservation_status")
}

model Venue {
  id     String  @id @db.VarChar(36)
  name   String
  events Event[]

  @@map("venues")
}

model Event {
  id           String        @id @db.VarChar(36)
  title        String
  venueId      String        @map("venue_id") @db.VarChar(36)
  startTime    DateTime      @map("start_time") @db.Timestamptz(3)
  endTime      DateTime      @map("end_time") @db.Timestamptz(3)
  capacity     Int
  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@index([venueId])
  @@map("events")
}

model Reservation {
  id          String            @id @db.VarChar(36)
  eventId     String            @map("event_id") @db.VarChar(36)
  userId      String            @map("user_id") @db.VarChar
  status      ReservationStatus
  reservedAt  DateTime          @map("reserved_at") @db.Timestamptz(3)
  cancelledAt DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)

  // CHECK制約と有効予約だけの一意索引は初回MigrationのSQLで管理する。
  @@index([eventId, status])
  @@index([eventId, userId, status])
  @@map("reservations")
}
